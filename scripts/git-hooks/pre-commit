#!/usr/bin/env bash
# Runs the data pipeline tests and the e2e tests (against a local `hugo server`)
# before allowing a commit. Skip with `SKIP_TESTS=1 git commit ...` or `--no-verify`.
set -euo pipefail

if [ "${SKIP_TESTS:-}" = "1" ]; then
    echo "pre-commit: SKIP_TESTS=1, skipping test suites"
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: running data pipeline tests (.venv)..."
if [ ! -x ".venv/Scripts/python.exe" ]; then
    echo "pre-commit: .venv not found — see README.md#tests to set it up" >&2
    exit 1
fi
.venv/Scripts/python.exe -m pytest

echo "pre-commit: running e2e tests against a local hugo server (e2e/.venv)..."
if [ ! -x "e2e/.venv/Scripts/python.exe" ]; then
    echo "pre-commit: e2e/.venv not found — see README.md#tests to set it up" >&2
    exit 1
fi

port=41313
hugo server --port "$port" --renderToMemory >/tmp/hugo-pre-commit.log 2>&1 &
hugo_pid=$!
cleanup() {
    kill "$hugo_pid" >/dev/null 2>&1 || true
    wait "$hugo_pid" 2>/dev/null || true
}
trap cleanup EXIT

echo "pre-commit: waiting for hugo server on :$port..."
for _ in $(seq 1 30); do
    if curl -s -o /dev/null "http://localhost:$port/"; then
        break
    fi
    sleep 1
done
if ! curl -s -o /dev/null "http://localhost:$port/"; then
    echo "pre-commit: hugo server didn't come up, see /tmp/hugo-pre-commit.log" >&2
    exit 1
fi

# Hugo's dev server links pages against "localhost", not 127.0.0.1, regardless of --bind.
E2E_BASE_URL="http://localhost:$port/" e2e/.venv/Scripts/python.exe -m pytest e2e
